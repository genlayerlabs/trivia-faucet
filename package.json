{
  "name": "trivia-faucet",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve:api": "node --env-file=.env.server server/index.mjs",
    "test": "node --test server/*.test.mjs shared/*.test.mjs",
    "reconcile": "node --env-file=.env.server server/reconcile.mjs",
    "test:integration": "node --test integration/*.test.mjs",
    "cancel": "TRIVIA_OPERATION=cancel node --env-file=.env.server server/reconcile.mjs",
    "test:studio": "node scripts/check-studio.mjs"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "ethers": "^6.16.0",
    "genlayer-js": "2.0.0-rc.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
